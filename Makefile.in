# Generated by configure from Makefile.in

prefix = @prefix@
bindir = @bindir@
datadir = @datadir@
sysconfdir = @sysconfdir@
systemdunitdir = @systemdunitdir@
GO = @GO@
top_srcdir = @top_srcdir@

INSTALL = install
CLIENT = client/kismet-crowpanel
PKGDATA = $(datadir)/kismet-crowpanel
FIRMWARE = firmware/prebuilt/crowpanel7.bin firmware/prebuilt/crowpanel5.bin firmware/prebuilt/SHA256SUMS
UNIT = packaging/systemd/kismet-crowpanel.service
CONF = packaging/systemd/kismet-crowpanel.conf

all: configured $(CLIENT)

$(CLIENT): FORCE
	cd client && $(GO) build -ldflags "-X 'main.dataDir=$(PKGDATA)'" -o kismet-crowpanel .

# Makefile and the service and config are out of date with their templates
configured:
	@for f in Makefile $(UNIT) $(CONF); do \
		if [ ! -e $$f ] || [ $$f.in -nt $$f ] || [ configure -nt $$f ]; then \
			echo "$$f is out of date: run ./configure again" >&2; exit 1; \
		fi; \
	done

install: all
	$(INSTALL) -d $(DESTDIR)$(bindir) $(DESTDIR)$(systemdunitdir) $(DESTDIR)$(sysconfdir)/kismet-crowpanel \
		$(DESTDIR)$(PKGDATA)/firmware
	$(INSTALL) -m 0755 $(CLIENT) $(DESTDIR)$(bindir)/kismet-crowpanel
	$(INSTALL) -m 0644 $(FIRMWARE) $(DESTDIR)$(PKGDATA)/firmware/
	$(INSTALL) -m 0644 $(UNIT) $(DESTDIR)$(systemdunitdir)/kismet-crowpanel.service
	@# never replace a config that may hold credentials
	@if [ -e $(DESTDIR)$(sysconfdir)/kismet-crowpanel/kismet-crowpanel.conf ]; then \
		echo "keeping $(DESTDIR)$(sysconfdir)/kismet-crowpanel/kismet-crowpanel.conf"; \
	else \
		echo "$(INSTALL) -m 0600 $(CONF) $(DESTDIR)$(sysconfdir)/kismet-crowpanel/kismet-crowpanel.conf"; \
		$(INSTALL) -m 0600 $(CONF) $(DESTDIR)$(sysconfdir)/kismet-crowpanel/kismet-crowpanel.conf; \
	fi

# the web viewer, for --web; build it first with web/build.sh
install-web:
	@[ -f web/dist/index.html ] || { echo "no web/dist: run web/build.sh first" >&2; exit 1; }
	$(INSTALL) -d $(DESTDIR)$(PKGDATA)/web
	$(INSTALL) -m 0644 web/dist/index.html web/dist/widget.js web/dist/widget.wasm $(DESTDIR)$(PKGDATA)/web/

# leaves the config, which may hold credentials
uninstall:
	rm -f $(DESTDIR)$(bindir)/kismet-crowpanel $(DESTDIR)$(systemdunitdir)/kismet-crowpanel.service
	rm -f $(DESTDIR)$(PKGDATA)/web/index.html $(DESTDIR)$(PKGDATA)/web/widget.js $(DESTDIR)$(PKGDATA)/web/widget.wasm
	rm -f $(DESTDIR)$(PKGDATA)/firmware/crowpanel7.bin $(DESTDIR)$(PKGDATA)/firmware/crowpanel5.bin \
		$(DESTDIR)$(PKGDATA)/firmware/SHA256SUMS

clean:
	rm -f $(CLIENT)

distclean: clean
	rm -f Makefile $(UNIT) $(CONF)

FORCE:

.PHONY: all configured install install-web uninstall clean distclean FORCE
