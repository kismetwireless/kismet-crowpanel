# Generated by configure from Makefile.in

prefix = @prefix@
bindir = @bindir@
datadir = @datadir@
sysconfdir = @sysconfdir@
systemdunitdir = @systemdunitdir@
GO = @GO@
top_srcdir = @top_srcdir@

INSTALL = install
CLIENT = client/kismet-crowpanel
UNIT = packaging/systemd/kismet-screen.service
CONF = packaging/systemd/kismet-screen.conf

all: configured $(CLIENT)

$(CLIENT): FORCE
	cd client && $(GO) build -o kismet-crowpanel .

# Makefile and the service and config are out of date with their templates
configured:
	@for f in Makefile $(UNIT) $(CONF); do \
		if [ ! -e $$f ] || [ $$f.in -nt $$f ] || [ configure -nt $$f ]; then \
			echo "$$f is out of date: run ./configure again" >&2; exit 1; \
		fi; \
	done

install: all
	$(INSTALL) -d $(DESTDIR)$(bindir) $(DESTDIR)$(systemdunitdir) $(DESTDIR)$(sysconfdir)/kismet-screen
	$(INSTALL) -m 0755 $(CLIENT) $(DESTDIR)$(bindir)/kismet-crowpanel
	$(INSTALL) -m 0644 $(UNIT) $(DESTDIR)$(systemdunitdir)/kismet-screen.service
	@# never replace a config that may hold credentials
	@if [ -e $(DESTDIR)$(sysconfdir)/kismet-screen/kismet-screen.conf ]; then \
		echo "keeping $(DESTDIR)$(sysconfdir)/kismet-screen/kismet-screen.conf"; \
	else \
		echo "$(INSTALL) -m 0600 $(CONF) $(DESTDIR)$(sysconfdir)/kismet-screen/kismet-screen.conf"; \
		$(INSTALL) -m 0600 $(CONF) $(DESTDIR)$(sysconfdir)/kismet-screen/kismet-screen.conf; \
	fi

# the web viewer, for --web; build it first with web/build.sh
install-web:
	@[ -f web/dist/index.html ] || { echo "no web/dist: run web/build.sh first" >&2; exit 1; }
	$(INSTALL) -d $(DESTDIR)$(datadir)/kismet-screen/web
	$(INSTALL) -m 0644 web/dist/index.html web/dist/widget.js web/dist/widget.wasm $(DESTDIR)$(datadir)/kismet-screen/web/

# leaves the config, which may hold credentials
uninstall:
	rm -f $(DESTDIR)$(bindir)/kismet-crowpanel $(DESTDIR)$(systemdunitdir)/kismet-screen.service
	rm -f $(DESTDIR)$(datadir)/kismet-screen/web/index.html $(DESTDIR)$(datadir)/kismet-screen/web/widget.js \
		$(DESTDIR)$(datadir)/kismet-screen/web/widget.wasm

clean:
	rm -f $(CLIENT)

distclean: clean
	rm -f Makefile $(UNIT) $(CONF)

FORCE:

.PHONY: all configured install install-web uninstall clean distclean FORCE
