# Kismet CrowPanel PC-side helper: polls Kismet and feeds the CrowPanel over
# serial (or, with --listen, over HTTP to Wi-Fi panels and the --web
# viewer).  Settings are in @sysconfdir@/kismet-screen/kismet-screen.conf.
#
# Generated by configure from kismet-screen.service.in; installed by
# "make install", then: systemctl daemon-reload && systemctl enable --now kismet-screen

[Unit]
Description=Kismet helper for the CrowPanel display
Wants=network-online.target
After=network-online.target kismet.service

[Service]
Type=simple
EnvironmentFile=@sysconfdir@/kismet-screen/kismet-screen.conf
ExecStart=@bindir@/kismet-crowpanel --kismet ${KISMET_URL} --cache-dir %C/kismet-screen $KISMET_SCREEN_ARGS
Restart=on-failure
RestartSec=5

DynamicUser=yes
CacheDirectory=kismet-screen
# for the panel's USB serial port; the group is uucp on Arch
SupplementaryGroups=dialout

# It needs the network (Kismet, map tiles) and the tty, so no PrivateNetwork
# or PrivateDevices; PrivateUsers would hide the dialout group
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

[Install]
WantedBy=multi-user.target
