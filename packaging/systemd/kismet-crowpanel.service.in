# Kismet CrowPanel PC-side helper: polls Kismet and feeds the CrowPanel over
# serial (or, with --listen, over HTTP to Wi-Fi panels and the --web
# viewer).  Settings are in @sysconfdir@/kismet-crowpanel/kismet-crowpanel.conf.
#
# Generated by configure from kismet-crowpanel.service.in; installed by
# "make install", then: systemctl daemon-reload && systemctl enable --now kismet-crowpanel

[Unit]
Description=Kismet helper for the CrowPanel display
Wants=network-online.target
After=network-online.target kismet.service

[Service]
Type=simple
EnvironmentFile=@sysconfdir@/kismet-crowpanel/kismet-crowpanel.conf
# kismet-crowpanel reads KISMET_URL, KISMET_USER, KISMET_APIKEY,
# KISMET_PASSWORD, CROWPANEL_SERIAL, CROWPANEL_BAUD and CROWPANEL_NOTIFY
# from the environment
ExecStart=@bindir@/kismet-crowpanel --cache-dir %C/kismet-crowpanel $CROWPANEL_ARGS
Restart=on-failure
RestartSec=5

DynamicUser=yes
CacheDirectory=kismet-crowpanel
# the notify socket, /run/kismet-crowpanel/notify.sock
RuntimeDirectory=kismet-crowpanel
RuntimeDirectoryMode=0755
# for the panel's USB serial port; the group is uucp on Arch
SupplementaryGroups=dialout

# It needs the network (Kismet, map tiles) and the tty, so no PrivateNetwork
# or PrivateDevices; PrivateUsers would hide the dialout group
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# no ProcSubset=pid: --serial auto reads /proc/locks to skip locked ports
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

[Install]
WantedBy=multi-user.target
