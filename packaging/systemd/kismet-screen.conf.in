# Settings for kismet-screen.service.  Keep this file mode 0600: it holds
# the Kismet credentials.  Restart the service after changing it.
# Generated by configure from kismet-screen.conf.in.

# Kismet server
KISMET_URL=http://localhost:2501

# Log in with an API key, or with a user and password
KISMET_APIKEY=
KISMET_USER=
KISMET_PASSWORD=

# The panel's USB serial port, or auto to find it.  auto listens for the
# panel on USB serial ports with a panel's bridge (CH340 or CH9102), skipping
# ports in use: those with a lock file or lock, or held exclusive (as gpsd
# does).  The service can't see which ports other users' programs merely
# have open, so name the port if another CH340 device is attached.  A
# /dev/serial/by-id/ path stays the same across replugs (ls /dev/serial/by-id/).
CROWPANEL_SERIAL=auto

# The panel's link starts at 115200 baud; the client moves it to this rate,
# or to the fastest slower one that works
CROWPANEL_BAUD=921600

# Other options for kismet-crowpanel (see kismet-crowpanel -h):
#   --listen ADDR      serve HTTP for Wi-Fi panels and --web (off by default):
#                      0.0.0.0 for the network, 127.0.0.1 for this machine only
#   --port N           HTTP port (default 8235)
#   --web              also serve the browser viewer, with --listen
#   --web-dir DIR      the built web viewer, with --web (default: the one
#                      "make install-web" puts in @datadir@/kismet-crowpanel/web)
#   --name NAME        server name when Kismet doesn't report one
#   --no-map           don't offer map tiles
#   --tile-cache-mb N  map tile cache cap (default 500)
#   -v                 verbose logging
KISMET_SCREEN_ARGS=
